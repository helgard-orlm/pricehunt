{
  "manifest_version": 3,
  "name": "pricehunt helper",
  "version": "0.2.0",
  "description": "Lets your local pricehunt agent read AliExpress product pages in your own browser, one page at a time.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.aliexpress.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.aliexpress.com/item/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.aliexpress.com/item/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.aliexpress.com/w/*"
      ],
      "js": [
        "searchpage.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.aliexpress.com/",
        "*://www.aliexpress.com/?*"
      ],
      "js": [
        "imgsearch.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "pricehunt"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pricehunt@helgard-orlm",
      "strict_min_version": "128.0"
    }
  }
}